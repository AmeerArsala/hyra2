#!/usr/bin/env python3
"""Launcher for the hyra CLI. The source lives in the repo's top-level `hyra/` package; this
finds it by walking up from this file's real location (symlinks resolved), and falls back to an
installed `hyra` package (`pip install` / `uv tool install` from the repo)."""
import os
import sys

here = os.path.dirname(os.path.realpath(__file__))
for _ in range(5):
    if os.path.isfile(os.path.join(here, "hyra", "cli.py")):
        sys.path.insert(0, here)
        break
    here = os.path.dirname(here)

from hyra.cli import main  # noqa: E402

main(sys.argv[1:])
